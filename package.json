{
  "name": "activity-box",
  "version": "0.0.1",
  "description": "⚡️📌️ Update a gist to contain your recent activity",
  "author": "Jason Etcovitch <jasonetco@gmail.com>",
  "license": "ISC",
  "scripts": {
    "test": "jest --coverage",
    "format": "prettier --write ./index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonEtco/activity-box.git"
  },
  "dependencies": {
    "actions-toolkit": "^4.0.0",
    "dotenv": "^8.2.0",
    "gist-box": "^0.3.1"
  },
  "devDependencies": {
    "husky": "^4.2.5",
    "jest": "^26.0.1",
    "nock": "^12.0.3",
    "prettier": "^2.0.5",
    "pretty-quick": "^2.0.1"
  },
  "overrides": {
    "@actions/core": "1.11.1",
    "@actions/http-client": "2.1.1",
    "@babel/helpers": "7.26.10",
    "@babel/traverse": "7.23.2",
    "brace-expansion@^1": "1.1.21",
    "cross-spawn@^6": "6.0.6",
    "cross-spawn@^7": "7.0.5",
    "debug@^4": "4.3.1",
    "decode-uri-component": "0.5.1",
    "flatted": "3.4.2",
    "form-data@^3": "3.0.5",
    "js-yaml@^3": "3.15.2",
    "jsdom": "16.7.0",
    "json5": "2.2.2",
    "lodash": "4.18.1",
    "micromatch@^4": "4.0.8",
    "minimatch@^3": "3.1.4",
    "minimist@^1": "1.2.6",
    "node-fetch@^2": "2.6.7",
    "path-parse": "1.0.7",
    "picomatch@^2": "2.3.2",
    "semver@^5": "5.7.2",
    "semver@^6": "6.3.1",
    "semver@^7": "7.5.2",
    "tough-cookie@^4": "4.1.3",
    "ws@^7": "7.5.11",
    "yaml@^1": "1.10.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
